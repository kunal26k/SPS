{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "SPS web only (Next.js dev)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3300
    },
    {
      "name": "SPS Website (Next.js dev)",
      "runtimeExecutable": "npm",
